-        return;
-    }
-    if(!isBlockFree((void *)KUSER_SHARED_DATA, KUSER_SHARED_SIZE)) {
-        printf_log(LOG_INFO, "KUSER branch: page still occupied after prereserve; MAP_FIXED_NOREPLACE will return c0000018\n");
-        return;
-    }
-    int idx = 0;
-    while(my_wine_reserve[idx].size) ++idx;
-    if(idx >= (int)(sizeof(my_wine_reserve) / sizeof(my_wine_reserve[0])) - 1) {
-        printf_log(LOG_INFO, "KUSER: prereserve table full, cannot add 0x7ffe0000\n");
-        return;
+    FILE *f = fopen("/proc/self/maps", "r");
+    if(f) {
+        char line[512];
+        while(fgets(line, sizeof(line), f)) {
+            uintptr_t s, e;
+            if(sscanf(line, "%lx-%lx", &s, &e) != 2) continue;
+            if(KUSER_SHARED_DATA < s || KUSER_SHARED_DATA >= e) continue;
+            if(strstr(line, "[stack]")) {
+                fclose(f);
+                printf_log(LOG_INFO, "KUSER branch: startup RW map skipped, 0x7ffe0000 is [stack]\n");
+                return;
+            }
+            break;
+        }
+        fclose(f);
     }
-    void *ret = mmap((void *)KUSER_SHARED_DATA, KUSER_SHARED_SIZE, 0,
-        MAP_FIXED | MAP_PRIVATE | MAP_ANON | MAP_NORESERVE, -1, 0);
+    void *ret = mmap((void *)KUSER_SHARED_DATA, KUSER_SHARED_SIZE,
+        PROT_READ | PROT_WRITE, MAP_FIXED | MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
     if(ret != (void *)KUSER_SHARED_DATA) {
-        printf_log(LOG_INFO, "KUSER: mmap(0x7ffe0000) failed: %s\n", strerror(errno));
+        printf_log(LOG_INFO, "KUSER branch: startup RW mmap(0x7ffe0000) failed: %s\n", strerror(errno));
