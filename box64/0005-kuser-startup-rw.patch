diff --git a/src/tools/wine_tools.c b/src/tools/wine_tools.c
index 36710ed..a981982 100644
--- a/src/tools/wine_tools.c
+++ b/src/tools/wine_tools.c
@@ -80,6 +80,8 @@ void preserve_highest32();
 #define KUSER_SHARED_DATA ((uintptr_t)0x7ffe0000)
 #define KUSER_SHARED_SIZE ((size_t)0x1000)
 
+static int kuser_ready = 0;
+
 int wine_prereserve_owns(uintptr_t addr, size_t size)
 {
     if(!size || addr + size < addr) return 0;
@@ -92,6 +94,19 @@ int wine_prereserve_owns(uintptr_t addr, size_t size)
     return 0;
 }
 
+int wine_kuser_noreplace(uintptr_t addr, size_t size)
+{
+    if(wine_prereserve_owns(addr, size)) return 1;
+    if(!kuser_ready || !size || addr + size < addr) return 0;
+    uintptr_t end = addr + size;
+    if(addr >= KUSER_SHARED_DATA && end <= KUSER_SHARED_DATA + KUSER_SHARED_SIZE)
+        return 1;
+    /* Wine asks for one host page. 16K hosts still start at 0x7ffe0000. */
+    if(addr == KUSER_SHARED_DATA && size <= 0x10000)
+        return 1;
+    return 0;
+}
