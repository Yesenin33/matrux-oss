+    if(!wine_prereserve_owns(KUSER_SHARED_DATA, KUSER_SHARED_SIZE)) {
+        int idx = 0;
+        while(my_wine_reserve[idx].size) ++idx;
+        if(idx < (int)(sizeof(my_wine_reserve) / sizeof(my_wine_reserve[0])) - 1) {
+            my_wine_reserve[idx].addr = (void *)KUSER_SHARED_DATA;
+            my_wine_reserve[idx].size = KUSER_SHARED_SIZE;
