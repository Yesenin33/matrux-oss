+#ifdef ANDROID
+// ---------------------------------------------------------------------------
+// 0016: the remaining glibc ABI that bionic neither exports nor has under the
+// __-name, imported by our x86_64 guests. A full `nm -uD` scan of every
+// x86_64 .so shipped in the runtime (see build-android-deps.sh, patch 0016)
+// showed that box64 already listed most of these as GO/GOW (-> dlsym into the
+// native libc); on bionic the dlsym yields NULL, so a guest's *global* PLT
+// import failed hard with
+//   "Symbol X not found, cannot apply R_X86_64_JUMP_SLOT".
+// The symbol that actually blocked libgnutls.so.30 was dcgettext; the rest are
+// the same class (libintl and the glibc string/malloc/fortify entry points)
+// found by the same scan.
+// gettext()/dgettext() were handled in 0013; this adds dcgettext and the rest
+// of the libintl family plus the other missing glibc entry points.
+// ---------------------------------------------------------------------------
+#include <fcntl.h>
+#include <errno.h>
+#include <sys/select.h>
+#include <sys/poll.h>
+#include <unistd.h>
+#include <sys/syscall.h>
+
+// ---- libintl: bionic has no libintl (and no NLS); the untranslated message is
+//      the correct answer when there is no catalogue.
+EXPORT char* my_dcgettext(x64emu_t* emu, const char* domainname, const char* msgid, int category)
+{
+    (void)emu; (void)domainname; (void)category;
+    return (char*)msgid;
+}
+EXPORT char* my___dcgettext(x64emu_t* emu, const char* domainname, const char* msgid, int category)
+{
+    (void)emu; (void)domainname; (void)category;
+    return (char*)msgid;
+}
+EXPORT char* my_ngettext(x64emu_t* emu, const char* msgid, const char* msgid_plural, unsigned long n)
+{
+    (void)emu;
+    return (char*)((n == 1) ? msgid : msgid_plural);
+}
+EXPORT char* my_dngettext(x64emu_t* emu, const char* domainname, const char* msgid, const char* msgid_plural, unsigned long n)
+{
+    (void)emu; (void)domainname;
+    return (char*)((n == 1) ? msgid : msgid_plural);
+}
+EXPORT char* my_dcngettext(x64emu_t* emu, const char* domainname, const char* msgid, const char* msgid_plural, unsigned long n, int category)
+{
+    (void)emu; (void)domainname; (void)category;
+    return (char*)((n == 1) ? msgid : msgid_plural);
+}
+EXPORT char* my_textdomain(x64emu_t* emu, const char* domainname)
+{
+    (void)emu;
+    // queries (NULL) return the current domain, which is "messages" by default
+    return (char*)(domainname ? domainname : "messages");
+}
+
+// ---- numeric parsing: bionic has the <fn>_l spelling, not glibc's __<fn>_l ----
+EXPORT long my___strtol_l(x64emu_t* emu, const char* nptr, char** endptr, int base, locale_t loc)
+{
+    (void)emu;
+    return strtol_l(nptr, endptr, base, loc);
+}
+EXPORT unsigned long my___strtoul_l(x64emu_t* emu, const char* nptr, char** endptr, int base, locale_t loc)
+{
+    (void)emu;
+    return strtoul_l(nptr, endptr, base, loc);
+}
+EXPORT long long my___strtoll_l(x64emu_t* emu, const char* nptr, char** endptr, int base, locale_t loc)
+{
+    (void)emu;
+    return strtoll_l(nptr, endptr, base, loc);
+}
+EXPORT unsigned long long my___strtoull_l(x64emu_t* emu, const char* nptr, char** endptr, int base, locale_t loc)
+{
+    (void)emu;
+    return strtoull_l(nptr, endptr, base, loc);
+}
+EXPORT long double my___strtold_l(x64emu_t* emu, const char* nptr, char** endptr, locale_t loc)
+{
+    (void)emu;
+    return strtold_l(nptr, endptr, loc);
+}
+
+// ---- string helpers glibc has and bionic does not ----
+EXPORT void* my_rawmemchr(x64emu_t* emu, const void* s, int c)
+{
+    (void)emu;
+    const unsigned char ch = (unsigned char)c;
+    const unsigned char* p = (const unsigned char*)s;
+    while (*p != ch) ++p;
+    return (void*)p;
+}
+EXPORT void* my___rawmemchr(x64emu_t* emu, const void* s, int c)
+{
+    (void)emu;
+    return my_rawmemchr(emu, s, c);
+}
+EXPORT char* my___stpcpy(x64emu_t* emu, char* dest, const char* src)
+{
+    (void)emu;
+    return stpcpy(dest, src);
+}
+EXPORT char* my___strtok_r(x64emu_t* emu, char* s, const char* delim, char** saveptr)
+{
+    (void)emu;
+    return strtok_r(s, delim, saveptr);
+}
+EXPORT char* my___strdup(x64emu_t* emu, const char* s)
+{
+    (void)emu;
+    return strdup(s);
+}
+EXPORT int my___strcasecmp(x64emu_t* emu, const char* a, const char* b)
+{
+    (void)emu;
+    return strcasecmp(a, b);
+}
+EXPORT char* my___strcasestr(x64emu_t* emu, const char* haystack, const char* needle)
+{
+    (void)emu;
+    return strcasestr(haystack, needle);
+}
+
+// ---- fortified variants: run the base function, skipping the guest-side check ----
+EXPORT unsigned long my___fdelt_chk(x64emu_t* emu, long fd)
+{
+    (void)emu;
+    if (fd < 0 || fd >= FD_SETSIZE)
+        return 0;
+    return (unsigned long)fd / (8 * sizeof(long));   // __NFDBITS == 8*sizeof(long)
+}
+EXPORT wchar_t* my___wcsncpy_chk(x64emu_t* emu, wchar_t* dest, const wchar_t* src, size_t n, size_t dstlen)
+{
+    (void)emu; (void)dstlen;
+    return wcsncpy(dest, src, n);
+}
+EXPORT size_t my___mbstowcs_chk(x64emu_t* emu, wchar_t* dst, const char* src, size_t n, size_t dstlen)
+{
+    (void)emu; (void)dstlen;
+    return mbstowcs(dst, src, n);
+}
+
+// ---- filesystem / misc glibc entry points ----
+EXPORT int my___open64_2(x64emu_t* emu, const char* path, int flags, int mode)
+{
+    (void)emu; (void)mode;      // glibc's __open64_2 has no mode argument
+    return open(path, flags);
+}
+EXPORT int my___openat64_2(x64emu_t* emu, int dirfd, const char* path, int flags, int mode)
+{
+    (void)emu; (void)mode;      // glibc's __openat64_2 has no mode argument
+    return openat(dirfd, path, flags);
+}
+EXPORT void* my___xpg_strerror_r(x64emu_t* emu, int errnum, char* buf, size_t buflen)
+{
+    (void)emu;
+    // glibc's __xpg_strerror_r is the XSI-compliant int strerror_r; forward it
+    return (void*)(intptr_t)strerror_r(errnum, buf, buflen);
+}
+EXPORT void* my___gmtime_r(x64emu_t* emu, const void* timep, void* result)
+{
+    (void)emu;
+    return gmtime_r((const time_t*)timep, (struct tm*)result);
+}
+EXPORT char* my_secure_getenv(x64emu_t* emu, const char* name)
+{
+    (void)emu;
+    // bionic has no secure_getenv; without AT_SECURE the result is the same
+    return getenv(name);
+}
+EXPORT char* my_index(x64emu_t* emu, const char* s, int c)
+{
+    (void)emu;
+    return strchr(s, c);        // deprecated glibc alias
+}
+EXPORT char* my_rindex(x64emu_t* emu, const char* s, int c)
+{
+    (void)emu;
+    return strrchr(s, c);       // deprecated glibc alias
+}
+EXPORT int my_close_range(x64emu_t* emu, unsigned int first, unsigned int last, int flags)
+{
+    (void)emu;
+#ifdef SYS_close_range
+    return syscall(SYS_close_range, first, last, (unsigned)flags);
+#else
+    if (flags) { errno = EINVAL; return -1; }
+    for (unsigned i = first; i <= last && i < 1024; ++i)
+        close((int)i);
+    return 0;
+#endif
+}
+EXPORT int my___poll(x64emu_t* emu, void* fds, unsigned long nfds, int timeout)
+{
+    (void)emu;
+    return poll((struct pollfd*)fds, (nfds_t)nfds, timeout);
+}
+EXPORT void* my___sbrk(x64emu_t* emu, long increment)
+{
+    (void)emu; (void)increment;
+    // bionic has no sbrk(); a real program never needs it under box64
+    errno = ENOMEM;
+    return (void*)-1;
+}
+EXPORT int my_getspnam_r(x64emu_t* emu, const char* name, void* spbuf, char* buf, size_t buflen, void* result)
+{
+    (void)emu; (void)name; (void)spbuf; (void)buf; (void)buflen; (void)result;
+    errno = ENOSYS;             // no shadow database on Android
+    return -1;
+}
+
+// ---- glibc internal malloc entry points (referenced by libc_malloc_debug.so) ----
+EXPORT void* my___libc_malloc(x64emu_t* emu, size_t size)
+{
+    (void)emu;
+    return malloc(size);
+}
+EXPORT void my___libc_free(x64emu_t* emu, void* p)
+{
+    (void)emu;
+    free(p);
+}
+EXPORT void* my___libc_realloc(x64emu_t* emu, void* p, size_t size)
+{
+    (void)emu;
+    return realloc(p, size);
+}
+EXPORT void* my___libc_memalign(x64emu_t* emu, size_t align, size_t size)
+{
+    (void)emu;
+    return memalign(align, size);
+}
+#endif
