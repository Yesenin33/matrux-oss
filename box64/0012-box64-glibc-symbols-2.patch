+#ifdef ANDROID
+// bionic lacks eaccess()/euidaccess() entirely (it only has access()/faccessat()).
+// glibc's eaccess/euidaccess check access against the *effective* uid/gid, which is
+// faccessat(AT_FDCWD, path, mode, AT_EACCESS). bionic's <fcntl.h> does not define
+// AT_EACCESS, and the underlying kernel faccessat2 syscall (and bionic's wrapper)
+// may not be available, so fall back to access() on EINVAL. euid==uid under
+// Wine/box64, so the fallback is semantically equivalent.
+#ifndef AT_EACCESS
+#define AT_EACCESS 0x200
+#endif
+EXPORT int my_eaccess(x64emu_t* emu, const char* path, int mode)
+{
+    (void)emu;
+    int ret = faccessat(AT_FDCWD, path, mode, AT_EACCESS);
+    if(ret == -1 && errno == EINVAL)
+        ret = access(path, mode);
+    return ret;
+}
+
+// glibc keeps euidaccess as the non-deprecated spelling of the same check.
+EXPORT int my_euidaccess(x64emu_t* emu, const char* path, int mode)
+{
+    return my_eaccess(emu, path, mode);
+}
+#endif
+
