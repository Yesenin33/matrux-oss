+// ---------------------------------------------------------------------------
+// 0013: further glibc symbols needed by our x86_64 guests (Mesa's libEGL etc.)
+// that bionic exports neither under the __-prefixed name nor at all.
+//   * the *_l (locale) family simply forwards to the bionic non-locale / *_l
+//     equivalent (the locale argument is honoured where bionic understands it);
+//   * __*_chk are the fortified variants -> call the base function, skipping
+//     the (guest-side) buffer-overflow check;
+//   * strtof128/strfromf128 are absent from bionic (no _Float128) -> stubs;
+//   * gettext()/dgettext() return the untranslated msgid, the rest are no-ops;
+//   * ZSTD_trace_* are optional libzstd hooks -> no-op stubs.
+// ---------------------------------------------------------------------------
+#include <locale.h>
+#include <langinfo.h>
+#include <time.h>
+#include <wctype.h>
+
+// bionic has newlocale/freelocale/duplocale/uselocale but not the __-spellings.
+EXPORT locale_t my___newlocale(x64emu_t* emu, int category_mask, const char* locale_name, locale_t base)
+{
+    (void)emu;
+    return newlocale(category_mask, locale_name, base);
+}
+EXPORT void my___freelocale(x64emu_t* emu, locale_t loc)
+{
+    (void)emu;
+    freelocale(loc);
+}
+EXPORT locale_t my___duplocale(x64emu_t* emu, locale_t loc)
+{
+    (void)emu;
+    return duplocale(loc);
+}
+EXPORT locale_t my___uselocale(x64emu_t* emu, locale_t loc)
+{
+    (void)emu;
+    return uselocale(loc);
+}
+
+// __<fn>_l: same as the bionic <fn>_l (or plain <fn>).
+EXPORT char* my___nl_langinfo_l(x64emu_t* emu, int item, locale_t loc)
+{
+    (void)emu;
+    return nl_langinfo_l((nl_item)item, loc);
+}
+EXPORT double my___strtod_l(x64emu_t* emu, const char* nptr, char** endptr, locale_t loc)
+{
+    (void)emu;
+    return strtod_l(nptr, endptr, loc);
+}
+EXPORT float my___strtof_l(x64emu_t* emu, const char* nptr, char** endptr, locale_t loc)
+{
+    (void)emu;
+    return strtof_l(nptr, endptr, loc);
+}
+EXPORT int my___strcoll_l(x64emu_t* emu, const char* a, const char* b, locale_t loc)
+{
+    (void)emu;
+    return strcoll_l(a, b, loc);
+}
+EXPORT size_t my___strxfrm_l(x64emu_t* emu, char* dest, const char* src, size_t n, locale_t loc)
+{
+    (void)emu;
+    return strxfrm_l(dest, src, n, loc);
+}
+EXPORT size_t my___strftime_l(x64emu_t* emu, char* s, size_t max, const char* format, const struct tm* tm, locale_t loc)
+{
+    (void)emu;
+    return strftime_l(s, max, format, tm, loc);
+}
+EXPORT size_t my___wcsftime_l(x64emu_t* emu, wchar_t* s, size_t max, const wchar_t* format, const struct tm* tm, locale_t loc)
+{
+    (void)emu;
+    return wcsftime_l(s, max, format, tm, loc);
+}
+EXPORT int my___wcscoll_l(x64emu_t* emu, const wchar_t* a, const wchar_t* b, locale_t loc)
+{
+    (void)emu;
+    return wcscoll_l(a, b, loc);
+}
+EXPORT size_t my___wcsxfrm_l(x64emu_t* emu, wchar_t* dest, const wchar_t* src, size_t n, locale_t loc)
+{
+    (void)emu;
+    return wcsxfrm_l(dest, src, n, loc);
+}
+EXPORT wint_t my___towlower_l(x64emu_t* emu, wint_t wc, locale_t loc)
+{
+    (void)emu;
+    return towlower_l(wc, loc);
+}
+EXPORT wint_t my___towupper_l(x64emu_t* emu, wint_t wc, locale_t loc)
+{
+    (void)emu;
+    return towupper_l(wc, loc);
+}
+EXPORT int my___iswctype_l(x64emu_t* emu, wint_t wc, wctype_t type, locale_t loc)
+{
+    (void)emu;
+    return iswctype_l(wc, type, loc);
+}
+EXPORT wctype_t my___wctype_l(x64emu_t* emu, const char* name, locale_t loc)
+{
+    (void)emu;
+    return wctype_l(name, loc);
+}
+
+// fortified variants: run the base function without the __*_chk overflow check.
+EXPORT wchar_t* my___wmemset_chk(x64emu_t* emu, wchar_t* s, wchar_t c, size_t n, size_t dstlen)
+{
+    (void)emu; (void)dstlen;
+    return wmemset(s, c, n);
+}
+EXPORT wchar_t* my___wmemcpy_chk(x64emu_t* emu, wchar_t* dest, const wchar_t* src, size_t n, size_t dstlen)
+{
+    (void)emu; (void)dstlen;
+    return wmemcpy(dest, src, n);
+}
+EXPORT size_t my___mbsrtowcs_chk(x64emu_t* emu, wchar_t* dst, const char** src, size_t len, mbstate_t* ps, size_t dstlen)
+{
+    (void)emu; (void)dstlen;
+    return mbsrtowcs(dst, src, len, ps);
+}
+
+// _Float128 variants: bionic has no _Float128; stub out (parse -> 0, format -> 0).
+EXPORT long double my_strtof128(x64emu_t* emu, const char* nptr, char** endptr)
+{
+    (void)emu; (void)nptr; (void)endptr;
+    return 0.0L;
+}
+EXPORT int my_strfromf128(x64emu_t* emu, char* s, size_t n, const char* format, long double fp)
+{
+    (void)emu; (void)s; (void)n; (void)format; (void)fp;
+    return 0;
+}
+
+// libintl: no bionic equivalent. gettext/dgettext return the untranslated msgid.
+EXPORT char* my_gettext(x64emu_t* emu, const char* msgid)
+{
+    (void)emu;
+    return (char*)msgid;
+}
+EXPORT char* my_dgettext(x64emu_t* emu, const char* domainname, const char* msgid)
+{
+    (void)emu; (void)domainname;
+    return (char*)msgid;
+}
+EXPORT char* my_bindtextdomain(x64emu_t* emu, const char* domainname, const char* dirname)
+{
+    (void)emu; (void)domainname; (void)dirname;
+    return NULL;
+}
+EXPORT char* my_bind_textdomain_codeset(x64emu_t* emu, const char* domainname, const char* codeset)
+{
+    (void)emu; (void)domainname; (void)codeset;
+    return NULL;
+}
+
+// optional libzstd trace hooks: no-ops.
+EXPORT void my_ZSTD_trace_decompress_begin(x64emu_t* emu, void* cctx)
+{
+    (void)emu; (void)cctx;
+}
+EXPORT void my_ZSTD_trace_decompress_end(x64emu_t* emu, void* cctx)
+{
+    (void)emu; (void)cctx;
+}
+EXPORT void my_ZSTD_trace_compress_begin(x64emu_t* emu, void* cctx)
+{
+    (void)emu; (void)cctx;
+}
+EXPORT void my_ZSTD_trace_compress_end(x64emu_t* emu, void* cctx)
+{
+    (void)emu; (void)cctx;
+}
+#endif
