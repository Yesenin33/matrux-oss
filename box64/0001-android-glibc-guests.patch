diff --git a/src/wrapped/wrappedlibc.c b/src/wrapped/wrappedlibc.c
index 65f41f15..3ce47de5 100644
--- a/src/wrapped/wrappedlibc.c
+++ b/src/wrapped/wrappedlibc.c
@@ -3522,8 +3522,284 @@ void InitCpuModel()
 #endif
 
 #ifdef ANDROID
+// ---------------------------------------------------------------------------
+// glibc x86_64 guests (Wine, Steam...) on a bionic host.
+// Upstream ANDROID build only targets x86_64 *bionic* guests (__libc_init).
+// Here: glibc-only symbols and glibc-numbered constants mapped onto bionic.
+// Set BOX64_BIONIC_GUEST=1 to disable the constant remapping.
+// ---------------------------------------------------------------------------
+#include <netdb.h>
+#include <langinfo.h>
+#include <assert.h>
+#include <limits.h>
+
+int box64_glibc_guest = 1;
+
+// glibc <ctype.h> tables, index -128..255
+#define GL_ISupper  0x0100
+#define GL_ISlower  0x0200
+#define GL_ISalpha  0x0400
+#define GL_ISdigit  0x0800
+#define GL_ISxdigit 0x1000
+#define GL_ISspace  0x2000
+#define GL_ISprint  0x4000
+#define GL_ISgraph  0x8000
+#define GL_ISblank  0x0001
+#define GL_IScntrl  0x0002
+#define GL_ISpunct  0x0004
+#define GL_ISalnum  0x0008
+static unsigned short glibc_ctype_b[384];
+static int32_t glibc_ctype_tolower[384];
+static int32_t glibc_ctype_toupper[384];
+EXPORT const unsigned short int *my___ctype_b = glibc_ctype_b + 128;
+EXPORT const int32_t *my___ctype_tolower = glibc_ctype_tolower + 128;
+EXPORT const int32_t *my___ctype_toupper = glibc_ctype_toupper + 128;
+
 void ctSetup()
 {
+    const char* bionic = getenv("BOX64_BIONIC_GUEST");
+    if(bionic && bionic[0]=='1')
+        box64_glibc_guest = 0;
+    for(int i=-128; i<256; ++i) {
+        unsigned short v = 0;
+        // glibc maps signed chars (except EOF) to their unsigned value
+        int32_t lo = (i<0 && i!=-1) ? i+256 : i, up = lo;
+        if(i>=0 && i<128) {   // "C" locale: only ASCII is classified
+            if(isupper(i))  v |= GL_ISupper;
+            if(islower(i))  v |= GL_ISlower;
+            if(isalpha(i))  v |= GL_ISalpha;
+            if(isdigit(i))  v |= GL_ISdigit;
+            if(isxdigit(i)) v |= GL_ISxdigit;
+            if(isspace(i))  v |= GL_ISspace;
+            if(isprint(i))  v |= GL_ISprint;
+            if(isgraph(i))  v |= GL_ISgraph;
+            if(isblank(i))  v |= GL_ISblank;
+            if(iscntrl(i))  v |= GL_IScntrl;
+            if(ispunct(i))  v |= GL_ISpunct;
+            if(isalnum(i))  v |= GL_ISalnum;
+            if(i>='A' && i<='Z') lo = i + 32;
+            if(i>='a' && i<='z') up = i - 32;
+        }
+        glibc_ctype_b[i+128] = v;
+        glibc_ctype_tolower[i+128] = lo;
+        glibc_ctype_toupper[i+128] = up;
+    }
+}
+EXPORT void* my___ctype_b_loc(void)       { return (void*)&my___ctype_b; }
+EXPORT void* my___ctype_tolower_loc(void) { return (void*)&my___ctype_tolower; }
+EXPORT void* my___ctype_toupper_loc(void) { return (void*)&my___ctype_toupper; }
+
+// errno / h_errno / assert
+EXPORT void* my___errno_location(void)   { return (void*)__errno(); }
+EXPORT void* my___h_errno_location(void) { return (void*)__get_h_errno(); }
+EXPORT void my___assert_fail(const char* assertion, const char* file, unsigned int line, const char* function)
+{
+    __assert2(file, (int)line, function?function:"?", assertion);
+}
+// POSIX basename (may modify its argument, like glibc's __xpg_basename)
+EXPORT char* my___xpg_basename(char* path)
+{
+    static char dot[] = ".";
+    if(!path || !*path) return dot;
+    size_t len = strlen(path);
+    while(len>1 && path[len-1]=='/') path[--len] = 0;
+    char* p = strrchr(path, '/');
+    return (p && p[1]) ? p+1 : path;
+}
+
+// resolver internals: bionic has no public _res, give a zeroed glibc-sized struct
+static char glibc_res_state[1024];
+EXPORT void* my___res_state(void) { return glibc_res_state; }
+EXPORT int my___res_init(void) { return 0; }
+
+// shm_open: no /dev/shm on Android, use a private directory (needed by esync)
+static int android_shm_path(const char* name, char* buff, size_t sz)
+{
+    const char* dir = getenv("BOX64_SHM_DIR");
+    if(!dir || !*dir) dir = getenv("TMPDIR");
+    if(!dir || !*dir) dir = "/data/local/tmp";
+    if(!name) { errno = EINVAL; return -1; }
+    while(*name=='/') ++name;
+    if(!*name || strchr(name, '/')) { errno = EINVAL; return -1; }
+    if(snprintf(buff, sz, "%s/shm-%s", dir, name) >= (int)sz) { errno = ENAMETOOLONG; return -1; }
+    return 0;
+}
+EXPORT int my_shm_open(const char* name, int oflag, uint32_t mode)
+{
+    char path[PATH_MAX];
+    if(android_shm_path(name, path, sizeof(path))) return -1;
+    return open(path, oflag | O_NOFOLLOW | O_CLOEXEC, (mode_t)mode);
+}
+EXPORT int my_shm_unlink(const char* name)
+{
+    char path[PATH_MAX];
+    if(android_shm_path(name, path, sizeof(path))) return -1;
+    return unlink(path);
+}
+
+// res_query: no public resolver API in bionic, report "no recovery" (dnsapi falls back)
+EXPORT int my_android_res_query(const char* dname, int cls, int type, unsigned char* answer, int anslen)
+{
+    (void)dname; (void)cls; (void)type; (void)answer; (void)anslen;
+    *__get_h_errno() = NO_RECOVERY;
+    return -1;
+}
+
+// nl_langinfo: glibc nl_item = (category<<16)|index
+EXPORT void* my_nl_langinfo(int item)
+{
+    if(!box64_glibc_guest) return nl_langinfo(item);
+    int n = -1;
+    int cat = item>>16, idx = item&0xffff;
+    switch(cat) {
+        case 0: if(idx==14) n = CODESET; break;                         // LC_CTYPE
+        case 1: if(idx==0) n = RADIXCHAR; else if(idx==1) n = THOUSEP; break; // LC_NUMERIC
+        case 2:                                                          // LC_TIME
+            if(idx<=6)       n = ABDAY_1 + idx;
+            else if(idx<=13) n = DAY_1 + (idx-7);
+            else if(idx<=25) n = ABMON_1 + (idx-14);
+            else if(idx<=37) n = MON_1 + (idx-26);
+            else switch(idx) {
+                case 38: n = AM_STR; break;
+                case 39: n = PM_STR; break;
+                case 40: n = D_T_FMT; break;
+                case 41: n = D_FMT; break;
+                case 42: n = T_FMT; break;
+                case 43: n = T_FMT_AMPM; break;
+            }
+            break;
+        case 4: if(idx==15) n = CRNCYSTR; break;                        // LC_MONETARY
+        case 5: if(idx==0) n = YESEXPR; else if(idx==1) n = NOEXPR; break; // LC_MESSAGES
+    }
+    if(n<0) return (void*)"";
+    return nl_langinfo(n);
+}
+
+// sysconf: glibc _SC_* -> bionic _SC_*
+int android_sc_from_glibc(int what)
+{
+    switch(what) {
+        case 0:   return _SC_ARG_MAX;
+        case 1:   return _SC_CHILD_MAX;
+        case 2:   return _SC_CLK_TCK;
+        case 3:   return _SC_NGROUPS_MAX;
+        case 4:   return _SC_OPEN_MAX;
+        case 5:   return _SC_STREAM_MAX;
+        case 30:  return _SC_PAGESIZE;
+        case 43:  return _SC_LINE_MAX;
+        case 60:  return _SC_IOV_MAX;
+        case 69:  return _SC_GETGR_R_SIZE_MAX;
+        case 70:  return _SC_GETPW_R_SIZE_MAX;
+        case 75:  return _SC_THREAD_STACK_MIN;
+        case 83:  return _SC_NPROCESSORS_CONF;
+        case 84:  return _SC_NPROCESSORS_ONLN;
+        case 85:  return _SC_PHYS_PAGES;
+        case 86:  return _SC_AVPHYS_PAGES;
+        case 149: return _SC_MONOTONIC_CLOCK;
+        case 180: return _SC_HOST_NAME_MAX;
+        case 190: return _SC_LEVEL1_DCACHE_LINESIZE;
+    }
+    return -1;
+}
+
+// getaddrinfo & co: glibc and bionic differ in AI_/NI_/EAI_ values,
+// and struct addrinfo has ai_addr/ai_canonname swapped
+#define GL_AI_PASSIVE     0x0001
+#define GL_AI_CANONNAME   0x0002
+#define GL_AI_NUMERICHOST 0x0004
+#define GL_AI_V4MAPPED    0x0008
+#define GL_AI_ALL         0x0010
+#define GL_AI_ADDRCONFIG  0x0020
+#define GL_AI_NUMERICSERV 0x0400
+static int gai_err_to_glibc(int r)
+{
+    switch(r) {
+        case 0:              return 0;
+        case EAI_BADFLAGS:   return -1;
+        case EAI_NONAME:     return -2;
+        case EAI_AGAIN:      return -3;
+        case EAI_FAIL:       return -4;
+        case EAI_NODATA:     return -5;
+        case EAI_FAMILY:     return -6;
+        case EAI_SOCKTYPE:   return -7;
+        case EAI_SERVICE:    return -8;
+        case EAI_ADDRFAMILY: return -9;
+        case EAI_MEMORY:     return -10;
+        case EAI_SYSTEM:     return -11;
+        case EAI_OVERFLOW:   return -12;
+    }
+    return -4;
+}
+static int gai_err_from_glibc(int r)
+{
+    switch(r) {
+        case 0:   return 0;
+        case -1:  return EAI_BADFLAGS;
+        case -2:  return EAI_NONAME;
+        case -3:  return EAI_AGAIN;
+        case -4:  return EAI_FAIL;
+        case -5:  return EAI_NODATA;
+        case -6:  return EAI_FAMILY;
+        case -7:  return EAI_SOCKTYPE;
+        case -8:  return EAI_SERVICE;
+        case -9:  return EAI_ADDRFAMILY;
+        case -10: return EAI_MEMORY;
+        case -11: return EAI_SYSTEM;
+        case -12: return EAI_OVERFLOW;
+    }
+    return r;
+}
+static void swap_addrinfo(struct addrinfo* ai)
+{
+    // ai_next is at the same offset in both layouts
+    for(; ai; ai = ai->ai_next) {
+        void* tmp = ai->ai_addr;
+        ai->ai_addr = (struct sockaddr*)ai->ai_canonname;
+        ai->ai_canonname = (char*)tmp;
+    }
+}
+EXPORT int my_getaddrinfo(const char* node, const char* service, const struct addrinfo* hints, struct addrinfo** res)
+{
+    if(!box64_glibc_guest) return getaddrinfo(node, service, hints, res);
+    struct addrinfo h, *ph = NULL;
+    if(hints) {
+        memset(&h, 0, sizeof(h));
+        int f = hints->ai_flags;
+        h.ai_flags = ((f&GL_AI_PASSIVE)?AI_PASSIVE:0) | ((f&GL_AI_CANONNAME)?AI_CANONNAME:0)
+                   | ((f&GL_AI_NUMERICHOST)?AI_NUMERICHOST:0) | ((f&GL_AI_NUMERICSERV)?AI_NUMERICSERV:0)
+                   | ((f&GL_AI_ADDRCONFIG)?AI_ADDRCONFIG:0);
+        // AI_V4MAPPED/AI_ALL are rejected by bionic getaddrinfo: dropped
+        h.ai_family = hints->ai_family;
+        h.ai_socktype = hints->ai_socktype;
+        h.ai_protocol = hints->ai_protocol;
+        ph = &h;
+    }
+    int r = getaddrinfo(node, service, ph, res);
+    if(!r && res) swap_addrinfo(*res);
+    return gai_err_to_glibc(r);
+}
+EXPORT void my_freeaddrinfo(struct addrinfo* ai)
+{
+    if(!ai) return;
+    if(box64_glibc_guest) swap_addrinfo(ai);
+    freeaddrinfo(ai);
+}
+EXPORT void* my_gai_strerror(int err)
+{
+    return (void*)gai_strerror(box64_glibc_guest?gai_err_from_glibc(err):err);
+}
+#define GL_NI_NUMERICHOST 1
+#define GL_NI_NUMERICSERV 2
+#define GL_NI_NOFQDN      4
+#define GL_NI_NAMEREQD    8
+#define GL_NI_DGRAM       16
+EXPORT int my_getnameinfo(void* sa, uint32_t salen, void* host, uint32_t hostlen, void* serv, uint32_t servlen, int flags)
+{
+    if(!box64_glibc_guest) return getnameinfo(sa, salen, host, hostlen, serv, servlen, flags);
+    int f = ((flags&GL_NI_NUMERICHOST)?NI_NUMERICHOST:0) | ((flags&GL_NI_NUMERICSERV)?NI_NUMERICSERV:0)
+          | ((flags&GL_NI_NOFQDN)?NI_NOFQDN:0) | ((flags&GL_NI_NAMEREQD)?NI_NAMEREQD:0)
+          | ((flags&GL_NI_DGRAM)?NI_DGRAM:0);
+    return gai_err_to_glibc(getnameinfo(sa, salen, host, hostlen, serv, servlen, f));
 }
 #else
 EXPORT const unsigned short int *my___ctype_b;
@@ -5290,6 +5566,13 @@ EXPORT int my_getpagesize(x64emu_t* emu) {
 EXPORT int my___getpagesize(x64emu_t* emu) __attribute__((alias("my_getpagesize")));
 
 EXPORT long my_sysconf(x64emu_t* emu, int what) {
+#ifdef ANDROID
+    // glibc guest: _SC_* numbering differs from bionic
+    if(box64_glibc_guest) {
+        what = android_sc_from_glibc(what);
+        if(what<0) { errno = EINVAL; return -1; }
+    }
+#endif
     if(what==_SC_PAGESIZE) {
         return X86_PAGE_SIZE;
     }
